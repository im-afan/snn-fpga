launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
open_bd_design {C:/Users/andre/Desktop/snn-fpga/vivado/snn_fpga/snn_fpga.srcs/sources_1/bd/microblaze/microblaze.bd}
set_property name spi [get_bd_intf_ports spi_rtl_0]
