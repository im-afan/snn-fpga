source {.\basys3_project.tcl}
start_gui
update_compile_order -fileset sources_1
open_run impl_1
report_timing_summary -delay_type min_max -report_unconstrained -check_timing_verbose -max_paths 10 -input_pins -routable_nets -name timing_1
launch_simulation
source top_microblaze.tcl
restart
add_force {/top_microblaze/clk} -radix hex {0 0ns} {1 5000ps} -repeat_every 10000ps
add_force {/top_microblaze/microblaze/snn_en_tri_o} -radix hex {0 0ns}
run 50 us
add_force {/top_microblaze/microblaze/snn_en_tri_o} -radix hex {1 0ns}
run 50 us
add_force {/top_microblaze/microblaze/snn_en_tri_o} -radix hex {0 0ns}
run 50 us
add_force {/top_microblaze/microblaze/snn_en_tri_o} -radix hex {1 0ns}
run 50 us
