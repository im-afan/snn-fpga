source {.\basys3_project.tcl}
start_gui
update_compile_order -fileset sources_1
launch_simulation
source top.tcl
restart
add_files ../src/hdl/bram/mem/tile_idx_bram.mem
close_sim
launch_simulation
source top.tcl
restart
add_force {/top/sw} -radix hex {0 0ns}
add_force {/top/clk} -radix hex {0 0ns} {1 5000ps} -repeat_every 10000ps
run 100 us
add_force {/top/sw} -radix hex {1 0ns}
run 100 us
close_sim
launch_simulation
source top.tcl
restart
add_force {/top/clk} -radix hex {0 0ns} {1 5000ps} -repeat_every 10000ps
add_force {/top/sw} -radix hex {0 0ns}
run 100 us
add_force {/top/sw} -radix hex {1 0ns}
run 100 us
run 100 us
run 100 us
run 100 us
add_force {/top/sw} -radix hex {0 0ns}
run 100 us
add_force {/top/sw} -radix hex {1 0ns}
run 100 us
run 100 us
run 100 us
run 100 us
launch_runs synth_1 -jobs 12
wait_on_run synth_1
reset_run synth_1
launch_runs synth_1 -jobs 8
wait_on_run synth_1
reset_run synth_1
close_sim
